# PostgreSQL Database (Neon DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synccaster?schema=public"

# FFmpeg & FFprobe system paths (set automatically in Docker)
FFMPEG_PATH="/usr/bin/ffmpeg"
FFPROBE_PATH="/usr/bin/ffprobe"

# Neon S3 / AWS S3 Object Storage Configuration
# All uploaded videos, overlays, and rendered MP4 outputs are stored in S3.
S3_ENDPOINT="https://ep-xxxx.c-4.ap-southeast-1.aws.neon.tech"  # Neon S3 endpoint URL
S3_REGION="auto"
S3_BUCKET="synccaster-storage"
S3_ACCESS_KEY_ID="your_access_key_id"
S3_SECRET_ACCESS_KEY="your_secret_access_KEY"
S3_FORCE_PATH_STYLE="true"
